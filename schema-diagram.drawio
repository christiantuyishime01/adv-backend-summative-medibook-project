        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    PATIENTS ||--o{ APPOINTMENTS : books\n    DOCTORS  ||--o{ APPOINTMENTS : sees\n\n    PATIENTS {\n        INT patient_id PK \&quot;AUTO_INCREMENT\&quot;\n        VARCHAR full_name \&quot;MySQL VARCHAR(150), NOT NULL\&quot;\n        VARCHAR email \&quot;MySQL VARCHAR(255), NOT NULL, UNIQUE\&quot;\n        VARCHAR phone \&quot;MySQL VARCHAR(12), NOT NULL, CHECK: exactly 12 digits\&quot;\n        TIMESTAMP created_at \&quot;DEFAULT CURRENT_TIMESTAMP\&quot;\n        TIMESTAMP updated_at \&quot;DEFAULT CURRENT_TIMESTAMP, ON UPDATE CURRENT_TIMESTAMP\&quot;\n    }\n\n    DOCTORS {\n        INT doctor_id PK \&quot;AUTO_INCREMENT\&quot;\n        VARCHAR full_name \&quot;MySQL VARCHAR(150), NOT NULL\&quot;\n        VARCHAR specialty \&quot;MySQL VARCHAR(100), NOT NULL\&quot;\n        DECIMAL consultation_fee \&quot;MySQL DECIMAL(10,2), NOT NULL, CHECK &gt;= 0\&quot;\n        VARCHAR room \&quot;MySQL VARCHAR(20), NOT NULL\&quot;\n        TIMESTAMP created_at \&quot;DEFAULT CURRENT_TIMESTAMP\&quot;\n        TIMESTAMP updated_at \&quot;DEFAULT CURRENT_TIMESTAMP, ON UPDATE CURRENT_TIMESTAMP\&quot;\n    }\n\n    APPOINTMENTS {\n        INT appointment_id PK \&quot;AUTO_INCREMENT\&quot;\n        INT patient_id FK \&quot;NOT NULL, ON DELETE RESTRICT\&quot;\n        INT doctor_id FK \&quot;NOT NULL, ON DELETE RESTRICT\&quot;\n        DATETIME appointment_datetime \&quot;NOT NULL, CHECK: start 09:00–16:30, minutes 00 or 30, seconds 00\&quot;\n        DECIMAL amount_paid \&quot;MySQL DECIMAL(10,2), NOT NULL, CHECK &gt;= 0\&quot;\n        ENUM status \&quot;MySQL ENUM(&#39;booked&#39;,&#39;cancelled&#39;), NOT NULL, DEFAULT &#39;booked&#39;\&quot;\n        DECIMAL refund_amount \&quot;MySQL DECIMAL(10,2), NOT NULL, DEFAULT 0.00, CHECK 0 &lt;= refund_amount &lt;= amount_paid\&quot;\n        DATETIME cancelled_at \&quot;NULL\&quot;\n        TIMESTAMP created_at \&quot;DEFAULT CURRENT_TIMESTAMP\&quot;\n        INT active_slot_doctor_id \&quot;GENERATED: doctor_id when booked, NULL when cancelled; UNIQUE(active_slot_doctor_id, appointment_datetime)\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v_EWZX-dMMRz9SkXK2BV-1">
