        <mxCell id="v_EWZX-dMMRz9SkXK2BV-123" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;p style=&quot;text-align: center;&quot;&gt;&lt;b&gt;APPLICATION RULES&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Booking must be in the future. Maximum 12 appointments per doctor per day (checked in a transaction).&lt;/li&gt;&lt;li&gt;Refund: &amp;gt;48 hours = 100%; 24–48 hours = 50%; &amp;lt;24 hours = 0%.&lt;/li&gt;&lt;li&gt;Cancellation keeps the appointment and refund history, and frees the slot for rebooking.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="620" x="60" y="910" as="geometry" />
        </mxCell>
